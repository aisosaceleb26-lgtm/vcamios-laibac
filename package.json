{
  "name": "deeplive-cam",
  "version": "1.0.0",
  "description": "Real-time video call face/body swap with voice changer using WebRTC",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "client:dev": "vite src/client/index.html",
    "client:build": "vite build src/client",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "video-call",
    "face-swap",
    "body-swap",
    "webrtc",
    "tensorflow.js",
    "mediapipe",
    "voice-changer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "simple-peer": "^9.11.1",
    "@tensorflow/tfjs": "^4.11.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.11.0",
    "@tensorflow/tfjs-backend-wasm": "^4.11.0",
    "@mediapipe/tasks-vision": "^0.10.8",
    "onnxruntime-web": "^1.17.0",
    "canvas": "^2.11.2",
    "ffmpeg.wasm": "^0.12.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pino": "^8.16.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "@types/node": "^20.6.0",
    "@types/express": "^4.17.20",
    "vite": "^4.5.0",
    "vitest": "^0.34.2",
    "eslint": "^8.49.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0"
  }
}
